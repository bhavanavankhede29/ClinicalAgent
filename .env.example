# Copy this file to ".env" and fill in your key, then restart the app.
# ".env" is git-ignored. Leave a value blank to fall back to the default.

# Enables LLM synthesis of retrieved evidence. Without it the app runs in
# evidence-only mode. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required ONLY if the key above is an "identity-linked" API key (you'll get a
# 400 "anthropic-workspace-id is required" without it). Looks like "wrkspc_...",
# found in the Anthropic Console under the workspace's settings.
ANTHROPIC_WORKSPACE_ID=

# Logins. 'admin' runs the console and does the final review of approved plans;
# 'doctor' signs in at /doctor to review + approve generated treatment plans.
# Change the passwords for anything beyond local use; set a fixed SESSION_SECRET
# so sessions survive a restart.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
DOCTOR_USER=doctor
DOCTOR_PASSWORD=admindoc
# SESSION_SECRET=
# SESSION_TTL=43200
# CLINICAL_AGENT_REVIEW_STORE=data/treatment_plans.json

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# CLINICAL_AGENT_TIMEOUT=20
# CLINICAL_AGENT_CONTACT=you@example.org

# Free key for the NHS website Content API (register at https://api.nhs.uk).
# Without it, the NHS conditions source is skipped (noted in the trace).
NHS_API_KEY=

# Sandbox FHIR R4 server for synthetic patient context (/api/fhir/*).
# NEVER point this at a server holding real PHI.
# FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Vector embeddings for the local knowledge base (RAG). With this set, chunks and
# queries are embedded with Voyage AI and retrieval is dense cosine similarity;
# without it, retrieval falls back to a local TF-IDF vector. Get a key at
# https://www.voyageai.com/
VOYAGE_API_KEY=
# CLINICAL_AGENT_EMBED_MODEL=voyage-3.5
# CLINICAL_AGENT_RAG_CHUNK_CHARS=500
# CLINICAL_AGENT_RAG_CHUNK_OVERLAP=100

# RAG / local knowledge base
# CLINICAL_AGENT_KNOWLEDGE_DIR=knowledge
# CLINICAL_AGENT_RAG_TOP_K=4
